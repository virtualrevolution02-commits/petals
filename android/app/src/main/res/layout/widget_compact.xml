<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Type 4: Compact Banner 1x4 — mini strip with photo + text side by side
     NOTE: marginHorizontal is NOT supported in RemoteViews on API < 26. Use marginStart/marginEnd instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="6dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg_rounded">

    <!-- Photo thumbnail -->
    <ImageView
        android:id="@+id/widget_compact_image"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_placeholder" />

    <!-- Divider -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#44FFFFFF" />

    <!-- Text info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_compact_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A beautiful moment 🌸"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_compact_poster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="from Partner · just now"
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
